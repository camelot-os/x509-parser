option(
  'cli',
  type: 'boolean',
  value: false,
  description: 'Build the x509-parser CLI executable from src/main.c (native build only)',
)

option(
  'ikos',
  type: 'boolean',
  value: false,
  description: 'Enable IKOS analysis target (native build only), generating ikos.db from src/x509-parser.c',
)

option(
  'proof',
  type: 'boolean',
  value: false,
  description: 'Enable Frama-C proof test (native build only)',
)
